# Скопируйте в .env и заполните.

# База данных. В Docker DB_DSN и DB_USER задаются в docker-compose.yml.
# На обычном хостинге (cPanel) раскомментируйте и укажите свои значения:
# DB_DSN=mysql:host=localhost;dbname=cpaneluser_crm
# DB_USER=cpaneluser_crm
DB_PASSWORD=change-me
# Только для Docker:
DB_ROOT_PASSWORD=change-me-root

# Случайная строка для подписи cookies (например: openssl rand -hex 32)
COOKIE_KEY=change-me

# Общий токен сайта для приёма лидов (POST /api/leads). Персональные токены — в разделе «API».
CRM_API_TOKEN=change-me
# С каких сайтов браузер может вызывать API: * — с любого, или домены через запятую
CRM_API_ORIGINS=*
# 1 — автоматически назначать новый лид наименее загруженному менеджеру
CRM_AUTO_ASSIGN=1

# Первый администратор (создаётся при старте, если его ещё нет)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Администратор

HTTP_PORT=8080
APP_TZ=Europe/Kyiv
YII_ENV=prod
YII_DEBUG=0
